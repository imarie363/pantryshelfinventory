# ---- Basics ----
# The password your household types once on each phone
PANTRY_PASSWORD=change-me
# Keeps everyone logged in across restarts. Make one with: openssl rand -hex 32
SESSION_SECRET=
# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel (the long value after --token)
TUNNEL_TOKEN=
# Your address, used for links in reminders
APP_URL=https://pantry.example.com
# Your time zone, for reminder and backup times (list: timedatectl list-timezones)
TZ=Europe/Amsterdam

# ---- Daily reminders ----
# Easiest: leave these empty and set reminders up in the app (Settings > Daily reminders).
# Values here are only starting values; whatever you save in the app wins.
# When to send them (24-hour clock) and how many days ahead to look
REMINDER_TIME=08:00
REMINDER_DAYS=7
# Fill in one or more channels below. Empty = that channel is off.

# Email through any SMTP server (Gmail: smtp.gmail.com, port 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Who gets the reminder; separate several addresses with commas
MAIL_TO=

# Telegram: a bot token from @BotFather and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy: a topic URL like https://ntfy.sh/pantry-<something-random>
NTFY_URL=
NTFY_TOKEN=

# ---- Backups ----
# A copy of everything is saved nightly to /srv/pantry-backups on the VM
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30
